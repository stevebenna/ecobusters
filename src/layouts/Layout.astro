---
interface Props {
  title?: string;
}
const { title = "Ecobusters ODV" } = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --red:    #E43823;
        --cream:  #F3E8CC;
        --yellow: #EFC128;
        --green:  #218737;
        --blue:   #1B468C;
        --bg:     #F3E8CC;
        --text:   #1a1a1a;
        --white:  #ffffff;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { scroll-behavior: smooth; }

      body {
        font-family: 'DM Sans', sans-serif;
        background-color: var(--bg);
        color: var(--text);
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* ── NAV ─────────────────────────────────────── */
      nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        background: var(--white);
        border-bottom: 3px solid var(--red);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 2rem;
        gap: 1rem;
        box-shadow: 0 2px 20px rgba(228,56,35,0.12);
      }

      .nav-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
      }

      .nav-logo img {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: contain;
        background: var(--white);
        border: 2px solid var(--cream);
      }

      .nav-logo span {
        font-family: 'Playfair Display', serif;
        font-weight: 900;
        font-size: 1.4rem;
        color: var(--red);
        letter-spacing: -0.02em;
      }

      .nav-links {
        display: flex;
        gap: 0.25rem;
        list-style: none;
      }

      .nav-links a {
        text-decoration: none;
        color: var(--text);
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        transition: background 0.2s, color 0.2s;
      }

      .nav-links a:hover {
        background: var(--red);
        color: var(--white);
      }

      /* Hamburger */
      .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
        padding: 4px;
      }
      .hamburger span {
        display: block;
        width: 26px;
        height: 2px;
        background: var(--text);
        border-radius: 2px;
        transition: all 0.3s;
      }

      @media (max-width: 700px) {
        .hamburger { display: flex; }
        .nav-links {
          display: none;
          position: fixed;
          top: 72px;
          left: 0; right: 0;
          background: var(--white);
          flex-direction: column;
          padding: 1rem;
          border-bottom: 3px solid var(--red);
          box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        }
        .nav-links.open { display: flex; }
        .nav-links a { padding: 0.75rem 1rem; }
      }

      /* ── HERO ────────────────────────────────────── */
      .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 7rem 2rem 4rem;
        position: relative;
        background: var(--bg);
        overflow: hidden;
      }

      .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(ellipse 60% 50% at 20% 80%, rgba(33,135,55,0.13) 0%, transparent 70%),
          radial-gradient(ellipse 50% 60% at 80% 20%, rgba(239,193,40,0.18) 0%, transparent 70%),
          radial-gradient(ellipse 40% 40% at 50% 50%, rgba(228,56,35,0.06) 0%, transparent 70%);
        pointer-events: none;
      }

      .hero-logo {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        object-fit: contain;
        background: var(--white);
        box-shadow: 0 8px 40px rgba(228,56,35,0.2), 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 2rem;
        animation: float 4s ease-in-out infinite;
      }

      @keyframes float {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-10px); }
      }

      .hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(3rem, 8vw, 6.5rem);
        font-weight: 900;
        line-height: 1;
        color: var(--green);
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
      }

      .hero p {
        font-size: clamp(1.1rem, 2.5vw, 1.35rem);
        font-weight: 300;
        color: var(--green);
        max-width: 540px;
        line-height: 1.6;
        margin-bottom: 2.5rem;
      }

      .btn-primary {
        display: inline-block;
        background: var(--red);
        color: var(--white);
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        text-decoration: none;
        padding: 0.85rem 2.5rem;
        border-radius: 50px;
        border: none;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 20px rgba(228,56,35,0.3);
      }
      .btn-primary:hover {
        background: #c02e18;
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(228,56,35,0.4);
      }

      /* decorative blobs */
      .blob {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        opacity: 0.14;
      }
      .blob-1 { width: 360px; height: 360px; background: var(--green); top: -80px; right: -80px; }
      .blob-2 { width: 260px; height: 260px; background: var(--yellow); bottom: 40px; left: -60px; }

      /* ── SECTIONS ────────────────────────────────── */
      section {
        padding: 5rem 2rem;
        max-width: 1200px;
        margin: 0 auto;
      }

      .section-label {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--white);
        background: var(--blue);
        padding: 0.35rem 1rem;
        border-radius: 50px;
        margin-bottom: 1rem;
      }

      .section-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 5vw, 3.2rem);
        font-weight: 900;
        color: var(--green);
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin-bottom: 2rem;
      }

      .section-divider {
        width: 60px;
        height: 4px;
        border-radius: 2px;
        background: var(--red);
        margin-bottom: 2.5rem;
      }

      /* ── CHI SIAMO ───────────────────────────────── */
      #chi-siamo {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
      }

      @media (max-width: 800px) {
        #chi-siamo { grid-template-columns: 1fr; }
      }

      .chi-siamo-text p {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #333;
        margin-bottom: 1.25rem;
      }

      .values-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      .value-card {
        background: var(--white);
        border-radius: 12px;
        padding: 1.25rem;
        border-left: 4px solid var(--red);
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
      }
      .value-card.green  { border-color: var(--green); }
      .value-card.yellow { border-color: var(--yellow); }
      .value-card.blue   { border-color: var(--blue); }

      .value-card h4 {
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.4rem;
        color: var(--blue);
      }
      .value-card p {
        font-size: 0.88rem;
        color: #555;
        line-height: 1.5;
      }

      /* ── EVENTI ──────────────────────────────────── */
      #eventi {
        background: none;
      }

      .eventi-header {
        text-align: center;
        margin-bottom: 3rem;
      }
      .eventi-header .section-divider { margin: 0 auto 2.5rem; }

      .gallery-wrapper {
        position: relative;
        overflow: hidden;
      }

      .gallery-track {
        display: flex;
        gap: 1.5rem;
        transition: transform 0.5s cubic-bezier(0.4,0,0.2,1);
      }

      .event-card {
        flex: 0 0 calc(33.333% - 1rem);
        min-width: 280px;
        background: var(--white);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        transition: transform 0.3s, box-shadow 0.3s;
      }
      .event-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 40px rgba(228,56,35,0.15);
      }

      .event-card img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
      }

      .event-card .event-info {
        padding: 1.25rem 1.4rem 1.5rem;
      }

      .event-card h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--blue);
        margin-bottom: 0.5rem;
      }

      .event-card p {
        font-size: 0.9rem;
        color: #555;
        line-height: 1.55;
      }

      .gallery-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-top: 2.5rem;
      }

      .gallery-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 2px solid var(--red);
        background: var(--white);
        color: var(--red);
        font-size: 1.2rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, color 0.2s;
      }
      .gallery-btn:hover {
        background: var(--red);
        color: var(--white);
      }

      .gallery-dots {
        display: flex;
        gap: 6px;
      }
      .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ccc;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
      }
      .dot.active {
        background: var(--red);
        transform: scale(1.3);
      }

      /* ── COLLABORA ───────────────────────────────── */
      #collabora {
        text-align: center;
      }

      .collabora-inner {
        background: var(--white);
        border-radius: 24px;
        padding: 3.5rem 2rem;
        box-shadow: 0 4px 40px rgba(0,0,0,0.07);
        max-width: 720px;
        margin: 0 auto;
      }

      .collabora-inner p {
        font-size: 1.05rem;
        color: #444;
        line-height: 1.75;
        margin-bottom: 2rem;
        max-width: 560px;
        margin-left: auto;
        margin-right: auto;
      }

      .contact-icons {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        justify-content: center;
        margin-top: 2rem;
      }

      .contact-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--blue);
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        border: 2px solid transparent;
        transition: border-color 0.2s, background 0.2s, transform 0.2s;
      }
      .contact-link:hover {
        border-color: var(--red);
        background: rgba(228,56,35,0.06);
        transform: translateY(-3px);
      }

      .contact-link img {
        width: 42px;
        height: 42px;
        object-fit: contain;
      }

      /* ── FOOTER ──────────────────────────────────── */
      footer {
        background: var(--blue);
        color: rgba(255,255,255,0.7);
        text-align: center;
        padding: 2rem 1rem;
        font-size: 0.88rem;
      }
      footer strong { color: var(--white); }

      /* ── FULL-WIDTH SECTION BAND ─────────────────── */
      .band {
        background: var(--bg);
      }
      .band-green {
        background: rgba(33,135,55,0.06);
        border-top: 1px solid rgba(33,135,55,0.12);
        border-bottom: 1px solid rgba(33,135,55,0.12);
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="#" class="nav-logo">
        <img src={`${import.meta.env.BASE_URL}/assets/logo.png`} alt="Ecobusters Logo" />
        <span>Ecobusters</span>
      </a>
      <button class="hamburger" id="burger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="#chi-siamo">Chi siamo</a></li>
        <li><a href="#eventi">Eventi</a></li>
        <li><a href="#collabora">Collabora</a></li>
      </ul>
    </nav>

    <slot />

    <footer>
      <p>&copy; {new Date().getFullYear()} <strong>Ecobusters</strong> – Organizzazione di Volontariato. Tutti i diritti riservati.</p>
    </footer>

    <script>
      const burger = document.getElementById('burger');
      const navLinks = document.getElementById('navLinks');
      burger?.addEventListener('click', () => navLinks?.classList.toggle('open'));
      // close on link click
      navLinks?.querySelectorAll('a').forEach(a =>
        a.addEventListener('click', () => navLinks.classList.remove('open'))
      );
    </script>
  </body>
</html>